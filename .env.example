PORT=3100

# Own database (docker-compose service `postgres`): programs, runs and their heartbeat
POSTGRES_DB=factory
POSTGRES_USER=factory
POSTGRES_PASSWORD=factory

# The assistant whose tools the agents use (ai-assistant)
ASSISTANT_URL=http://localhost:3000
ASSISTANT_ISSUER=ai-assistant
# This factory as the assistant's machine client: there, pnpm machine:create agent-factory, and
# copy the secret it leaves into this file
ASSISTANT_CLIENT_ID=agent-factory
ASSISTANT_CLIENT_SECRET_FILE=secrets/agent-factory.secret
